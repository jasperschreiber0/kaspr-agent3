# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Twilio (WhatsApp notifications)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+61400000000

# Instagram Graph API
# (stored per-client in clients table: instagram_access_token, instagram_account_id)

# TikTok Content API — used by src/tiktokAuth.js (OAuth) and
# src/tokenRefresh.js (token refresh). Required at startup.
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
# (per-client tokens stored in clients table: tiktok_access_token,
# tiktok_refresh_token, tiktok_token_expires_at, tiktok_account_id)

# Discord
DISCORD_WEBHOOK_KASPR_LOGS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_KASPR_ERRORS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_KASPR_POSTS=https://discord.com/api/webhooks/...

PORT=3003
